# Porta HTTP da API
PORT=3333

# Segredo usado para assinar os tokens JWT. TROQUE em produção.
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="8h"

# Origem(ns) permitida(s) no CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:3000"

# Caminho do arquivo JSON que funciona como banco de dados
DB_FILE="./data/db.json"

# Data de referência ("agora") usada pelo motor de análise.
# Os dados de demonstração são ancorados em 29/09/2026. Deixe vazio para usar a data real.
REFERENCE_DATE="2026-09-29T23:59:59.000Z"

# Modo demonstração: habilita troca rápida de perfil e restauração dos dados padrão
DEMO_MODE=true

# Senha atribuída aos usuários de demonstração (e a novos usuários criados sem senha)
DEMO_PASSWORD="demo123456"
